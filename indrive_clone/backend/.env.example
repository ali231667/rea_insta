# ---------- Server ----------
PORT=4000
NODE_ENV=development
# Public URL of this server (used for uploaded image links)
PUBLIC_URL=http://localhost:4000

# ---------- Databases ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/indrive
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
# Change these to long random strings (for example: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# In development the OTP code is printed in the server log and sent back to the app.
# Set to false when you add a real SMS provider (Twilio settings below).
DEV_OTP=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Drivers ----------
# true = new drivers are approved at once (good for demos).
# false = an admin must approve them at http://localhost:4000/admin
AUTO_APPROVE_DRIVERS=true
ADMIN_KEY=admin123

# ---------- Maps ----------
# If you add a Google Maps key, Google Routes + Places are used.
# If empty, free OpenStreetMap services (OSRM + Nominatim) are used.
GOOGLE_MAPS_API_KEY=
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org

# ---------- Matching (how drivers are found) ----------
INITIAL_RADIUS_M=3000
RADIUS_STEP_M=2000
MAX_RADIUS_M=7000
EXPAND_EVERY_SEC=30
REQUEST_TTL_SEC=300
OFFER_TTL_SEC=45
COMMISSION_RATE=0.10
