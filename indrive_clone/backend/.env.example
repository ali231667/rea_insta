# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/indrive

# Secret used to sign login tokens (change this!)
JWT_SECRET=change-me-to-a-long-random-string

# In development the OTP code is printed in the console and sent back to the app.
# Set to false when you connect a real SMS provider.
DEV_OTP=true

# Drivers are approved automatically (good for demos). Set false to approve from /admin.
AUTO_APPROVE_DRIVERS=true

# Key for the admin panel at http://localhost:4000/admin
ADMIN_KEY=admin123

# Free map services (OpenStreetMap). You can point these to your own servers.
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Optional Twilio SMS (only used when DEV_OTP=false)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
