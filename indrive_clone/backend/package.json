{
  "name": "indrive-clone-backend",
  "version": "1.0.0",
  "description": "Backend for the InDrive clone (student project): REST API + Socket.IO realtime + PostgreSQL",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
